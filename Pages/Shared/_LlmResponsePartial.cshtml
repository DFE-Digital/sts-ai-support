@model LlmResponseViewModel

<div class="container">
	@foreach (var question in Model.Questions)
	{
		<div class="row">
			<div class="col">
				<p>@question.Text</p>
			</div>
		</div>

		@foreach (var answer in question.Answers)
		{
			<div class="row">
				<div class="col">
					<p>@answer.Text</p>
				</div>
			</div>

			@foreach (var recommendation in answer.Recommendations)
			{
				<div class="row">
					<div class="col">
						<p>@recommendation</p>
					</div>
				</div>
			}
		}
	}
</div>