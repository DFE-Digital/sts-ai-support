@page
@namespace sts_ai_support.Pages
@model StandardsGeneratorModel
@{
	ViewData["Title"] = "Standards Generator";
}

<div class="row">
	<div class="col text-center">
		<h1 class="display-4">@ViewData["Title"]</h1>
	</div>
	<div id="ai-form" class="col-12">
		<form method="post">
			<label for="user-prompt" class="form-label" style"font-weight: bold;">What's the name of the standard you want to create?</label>
			<input type="text" class="form-control" id="user-prompt" name="user-prompt" />
			<br />

			<div class="accordion" id="system-prompt-accordion">
				<div class="accordion-item">
					<h2 class="accordion-header" id="system-prompt-header">
						<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#system-prompt-textarea" aria-expanded="true" aria-controls="system-prompt-textarea">
							<strong>Click to view/edit system prompt</strong>
						</button>
					</h2>
					<div id="system-prompt-textarea" class="accordion-collapse collapse" aria-labelledby="system-prompt-header" data-bs-parent="#system-prompt-accordion">
						<div class="accordion-body">
							<textarea class="form-control" asp-for="SystemPrompt" name="system-prompt" id="system-prompt" rows="20" title="System prompt"></textarea>
						</div>
					</div>
				</div>
			</div>
			<br />

			<input class="btn btn-primary" type="submit" value="Generate" style="margin-top: 0.5em;" />
			<br />
		</form>
	</div>
	<div class="col-12 text-center">
		<div id="generating-spinner" style="display: none; margin: 2em;">
			<div class="spinner-border text-primary" role="status"></div>
			<div>
				<span class="sr-only">Generating...</span>
			</div>
		</div>
	</div>
	<div id="ai-response" class="col-12">
	</div>
</div>

<script src="~/js/standardsGeneratorScripts.js?v=@DateTime.UtcNow.Ticks"></script>

